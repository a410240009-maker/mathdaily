    let isMusicPlaying = false;
    let musicLoop = null;
    let musicSynth = null;

    async function toggleIslamicMusic() {
      const btn = document.getElementById('btn-music-toggle');
      const icon = document.getElementById('music-icon');
      const label = document.getElementById('music-label');

      try {
        if (typeof Tone === 'undefined') {
          showToast('Fitur audio sedang dimuat, coba sebentar lagi.', 'warning');
          return;
        }
        if (isMusicPlaying) {
          if (musicLoop) musicLoop.stop();
          Tone.Transport.stop();
          isMusicPlaying = false;
          if (btn) btn.className = 'flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-700 font-extrabold text-xs sm:text-sm hover:bg-emerald-100 transition';
          if (icon) icon.className = 'fa-solid fa-music';
          if (label) label.textContent = 'Musik';
          showToast('Musik latar dijeda.', 'info');
          return;
        }

        await Tone.start();
        if (!musicSynth) {
          musicSynth = new Tone.PolySynth(Tone.Synth, {
            oscillator: { type: 'triangle' },
            envelope: { attack: 0.08, decay: 0.25, sustain: 0.3, release: 0.9 }
          }).toDestination();
          musicSynth.volume.value = -14;

          const hijazNotes = ['D4', 'Eb4', 'F#4', 'G4', 'A4', 'Bb4', 'A4', 'G4', 'F#4', 'Eb4', 'D4', null];
          let step = 0;
          musicLoop = new Tone.Loop((time) => {
            const note = hijazNotes[step % hijazNotes.length];
            if (note) {
              musicSynth.triggerAttackRelease(note, '8n', time);
            }
            step++;
          }, '4n');
        }

        Tone.Transport.bpm.value = 92;
        musicLoop.start(0);
        Tone.Transport.start();
        isMusicPlaying = true;
        if (btn) btn.className = 'flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-2xl bg-emerald-500 border border-emerald-600 text-white font-extrabold text-xs sm:text-sm shadow-sm transition';
        if (icon) icon.className = 'fa-solid fa-volume-high animate-pulse';
        if (label) label.textContent = 'Aktif';
        showToast('Musik latar islami diputar.', 'success');
      } catch (err) {
        showToast('Klik layar sekali lagi untuk mengaktifkan audio.', 'info');
      }
    }

    function playFeedbackTone(isCorrect) {
      try {
        if (typeof Tone === 'undefined') return;
        const sfx = new Tone.Synth().toDestination();
        sfx.volume.value = -10;
        if (isCorrect) {
          sfx.triggerAttackRelease('C5', '16n');
          setTimeout(() => sfx.triggerAttackRelease('E5', '16n'), 90);
          setTimeout(() => sfx.triggerAttackRelease('G5', '8n'), 180);
        } else {
          sfx.triggerAttackRelease('E4', '16n');
          setTimeout(() => sfx.triggerAttackRelease('C4', '8n'), 120);
        }
      } catch (e) {}
    }

